* Extra queues on top of the developer defaults (DEV.QUEUE.1-3, DEV.DEAD.LETTER.QUEUE).
* Runs at every container start, so REPLACE keeps it idempotent.

DEFINE QLOCAL('PAYMENTS.IN')   MAXDEPTH(5000) DESCR('Incoming payment instructions') REPLACE
DEFINE QLOCAL('PAYMENTS.OUT')  MAXDEPTH(5000) DESCR('Payment confirmations') REPLACE
DEFINE QLOCAL('ORDERS.IN')     MAXDEPTH(100)  DESCR('Small max depth to see the depth bar turn red') REPLACE
DEFINE QLOCAL('FIX.IN')        DESCR('SOH-separated FIX messages') REPLACE
DEFINE QLOCAL('FRAMED.IN')     DESCR('STX/ETX framed messages') REPLACE
DEFINE QLOCAL('AUDIT.LOG')     DESCR('Read-only for the app user') REPLACE
DEFINE QLOCAL('LOCKED.Q')      PUT(DISABLED) DESCR('Put inhibited') REPLACE
DEFINE QALIAS('PAYMENTS.API')  TARGET('PAYMENTS.IN') REPLACE

* The app user (principal app) gets the same rights on these as on DEV.**; AUDIT.LOG is browse-only.
SET AUTHREC PROFILE('PAYMENTS.**') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('ORDERS.**')   OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('FIX.**')      OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('FRAMED.**')   OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('LOCKED.Q')    OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,GET,INQ,PUT,DSP)
SET AUTHREC PROFILE('AUDIT.LOG')   OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(BROWSE,INQ,DSP)
